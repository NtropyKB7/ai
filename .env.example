# Required by the application. Add a real value only to an untracked .env.
OPENAI_API_KEY=
OPENAI_CLASSIFICATION_MODEL=gpt-5-nano
OPENAI_GENERATION_MODEL=gpt-4o-mini
OPENAI_CLASSIFICATION_MAX_CONCURRENCY=4
OPENAI_CLASSIFICATION_HTTP_TIMEOUT_SECONDS=20
OPENAI_CLASSIFICATION_TIMEOUT_SECONDS=25
OPENAI_CLASSIFICATION_MAX_RETRIES=0
OPENAI_CLASSIFICATION_CHUNK_SIZE=5

# Optional Finlife collector credential. Leave empty when the collector is unused.
FINLIFE_API_KEY=

# Docker Compose host path. The safe development default is repository-local
# and ignored by both Git and Docker builds.
CHROMA_HOST_DIR=./.local/chroma-data

# Chroma path and active collection inside the application container.
CHROMA_DB_DIR=/data/chroma
FINANCIAL_PRODUCT_COLLECTION=financial_products
